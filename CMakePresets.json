{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}"
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x86-64, Release",
      "inherits": ["linux", "base", "release"]
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x86-64, Debug",
      "inherits": ["linux", "base", "debug"]
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS arm64, Release",
      "inherits": ["macos", "base", "release"],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS arm64, Debug",
      "inherits": ["macos", "base", "debug"],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x86-64, Release (Visual Studio 2022 developer environment)",
      "inherits": ["windows", "base", "release"]
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x86-64, Debug (Visual Studio 2022 developer environment)",
      "inherits": ["windows", "base", "debug"]
    }
  ],
  "buildPresets": [
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64-release"
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64-debug"
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release"
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-x64-release",
      "inherits": "base",
      "configurePreset": "linux-x64-release"
    },
    {
      "name": "linux-x64-debug",
      "inherits": "base",
      "configurePreset": "linux-x64-debug"
    },
    {
      "name": "macos-arm64-release",
      "inherits": "base",
      "configurePreset": "macos-arm64-release"
    },
    {
      "name": "macos-arm64-debug",
      "inherits": "base",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "windows-x64-release",
      "inherits": "base",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "windows-x64-debug",
      "inherits": "base",
      "configurePreset": "windows-x64-debug"
    }
  ]
}
