# PraenoraRuntimeDepsConfigVersion.cmake: version and platform check of the dependency bundle
# @PRAENORA_DEPS_PACKAGE_NAME@.
#
# Generated by praenora-runtime-deps (@PRAENORA_DEPS_HOMEPAGE@).
#
# Version: a requested version is compatible when the bundle's version is at least that version
# and, for versions 0.x, has the same major and minor version, or, from 1.0, the same major
# version. Version ranges are honored. With no version requested, any version is compatible.
#
# Platform: the bundle is unsuitable, whatever its version, when the consuming project targets
# another operating system or architecture, or a macOS deployment target older than the bundle's,
# or, with MSVC, an older toolset than the one that built the bundle. The reasons are appended to
# the version that find_package reports for a configuration file it did not accept.

set(PACKAGE_VERSION "@PRAENORA_DEPS_VERSION@")

# Version.
set(_praenora_deps_version "${PACKAGE_VERSION}")
string(REGEX MATCH "^[0-9]+" _praenora_deps_major "${_praenora_deps_version}")
string(REGEX MATCH "^[0-9]+\\.([0-9]+)" _praenora_deps_minor "${_praenora_deps_version}")
set(_praenora_deps_minor "${CMAKE_MATCH_1}")
set(PACKAGE_VERSION_COMPATIBLE FALSE)
if(PACKAGE_FIND_VERSION_RANGE)
    if(NOT _praenora_deps_version VERSION_LESS PACKAGE_FIND_VERSION_MIN AND
       ((PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "INCLUDE" AND
         NOT _praenora_deps_version VERSION_GREATER PACKAGE_FIND_VERSION_MAX) OR
        (PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "EXCLUDE" AND
         _praenora_deps_version VERSION_LESS PACKAGE_FIND_VERSION_MAX)))
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
    endif()
elseif(NOT PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
elseif(NOT _praenora_deps_version VERSION_LESS PACKAGE_FIND_VERSION)
    if(_praenora_deps_major EQUAL 0)
        if(PACKAGE_FIND_VERSION_MAJOR EQUAL 0 AND
           PACKAGE_FIND_VERSION_MINOR EQUAL _praenora_deps_minor)
            set(PACKAGE_VERSION_COMPATIBLE TRUE)
        endif()
    elseif(PACKAGE_FIND_VERSION_MAJOR EQUAL _praenora_deps_major)
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
    endif()
    if(PACKAGE_FIND_VERSION VERSION_EQUAL _praenora_deps_version)
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
endif()

# Platform.
set(_praenora_deps_reasons "")
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    set(_praenora_deps_os macos)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
    set(_praenora_deps_os windows)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(_praenora_deps_os linux)
else()
    set(_praenora_deps_os "${CMAKE_SYSTEM_NAME}")
endif()
if(NOT _praenora_deps_os STREQUAL "@PRAENORA_DEPS_OS@")
    list(APPEND _praenora_deps_reasons "built for @PRAENORA_DEPS_OS@, not ${_praenora_deps_os}")
endif()

if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_OSX_ARCHITECTURES)
    set(_praenora_deps_arch "${CMAKE_OSX_ARCHITECTURES}")
elseif(CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
    set(_praenora_deps_arch "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
else()
    set(_praenora_deps_arch "${CMAKE_SYSTEM_PROCESSOR}")
endif()
if(_praenora_deps_arch MATCHES "^(x86_64|AMD64|amd64|x64)$")
    set(_praenora_deps_arch x86_64)
elseif(_praenora_deps_arch MATCHES "^(arm64|ARM64|aarch64)$")
    set(_praenora_deps_arch arm64)
endif()
if(NOT _praenora_deps_arch STREQUAL "@PRAENORA_DEPS_ARCH@")
    list(APPEND _praenora_deps_reasons "built for @PRAENORA_DEPS_ARCH@, not ${_praenora_deps_arch}")
endif()
if(DEFINED CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    list(APPEND _praenora_deps_reasons "built for 64-bit targets")
endif()

if("@PRAENORA_DEPS_OS_MIN_VERSION@" AND CMAKE_OSX_DEPLOYMENT_TARGET AND
   CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS "@PRAENORA_DEPS_OS_MIN_VERSION@")
    list(APPEND _praenora_deps_reasons "needs CMAKE_OSX_DEPLOYMENT_TARGET \
@PRAENORA_DEPS_OS_MIN_VERSION@ or later, not ${CMAKE_OSX_DEPLOYMENT_TARGET}")
endif()

if("@PRAENORA_DEPS_MSVC_TOOLSET@" AND MSVC_TOOLSET_VERSION AND
   MSVC_TOOLSET_VERSION LESS "@PRAENORA_DEPS_MSVC_TOOLSET@")
    list(APPEND _praenora_deps_reasons "needs MSVC toolset @PRAENORA_DEPS_MSVC_TOOLSET@ or \
later, not ${MSVC_TOOLSET_VERSION}")
endif()

if(_praenora_deps_reasons)
    list(JOIN _praenora_deps_reasons "; " _praenora_deps_reasons)
    set(PACKAGE_VERSION
        "${PACKAGE_VERSION} (@PRAENORA_DEPS_PACKAGE_NAME@: ${_praenora_deps_reasons})")
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif()

unset(_praenora_deps_version)
unset(_praenora_deps_major)
unset(_praenora_deps_minor)
unset(_praenora_deps_os)
unset(_praenora_deps_arch)
unset(_praenora_deps_reasons)
