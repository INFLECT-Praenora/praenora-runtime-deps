# PraenoraRuntimeDepsConfig.cmake: the dependency bundle @PRAENORA_DEPS_PACKAGE_NAME@.
#
# Generated by praenora-runtime-deps (@PRAENORA_DEPS_HOMEPAGE@). It defines variables
# only, no targets: the Praenora runtime finds json-schema-validator, nlohmann/json, libRoadRunner,
# LLVM and libAntimony with its own finders, through PraenoraRuntimeDeps_PREFIX_PATH and
# PraenoraRuntimeDeps_LLVM_INSTALL_PREFIX.
# PraenoraRuntimeDepsConfigVersion.cmake refuses a bundle built for another platform
# (docs/outputs.md in praenora-runtime-deps).

get_filename_component(PraenoraRuntimeDeps_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(PraenoraRuntimeDeps_MANIFEST "${PraenoraRuntimeDeps_ROOT}/praenora-runtime-deps.json")
set(PraenoraRuntimeDeps_PACKAGE_NAME "@PRAENORA_DEPS_PACKAGE_NAME@")

# Labels.
set(PraenoraRuntimeDeps_OS "@PRAENORA_DEPS_OS@")
set(PraenoraRuntimeDeps_ARCH "@PRAENORA_DEPS_ARCH@")
set(PraenoraRuntimeDeps_OS_MIN_VERSION "@PRAENORA_DEPS_OS_MIN_VERSION@")
set(PraenoraRuntimeDeps_COMPILER_ID "@PRAENORA_DEPS_COMPILER_ID@")
set(PraenoraRuntimeDeps_COMPILER_VERSION "@PRAENORA_DEPS_COMPILER_VERSION@")
set(PraenoraRuntimeDeps_COMPILER_LABEL "@PRAENORA_DEPS_COMPILER_LABEL@")
set(PraenoraRuntimeDeps_CXX_STDLIB "@PRAENORA_DEPS_CXX_STDLIB@")
set(PraenoraRuntimeDeps_MSVC_RUNTIME "@PRAENORA_DEPS_MSVC_RUNTIME@")
set(PraenoraRuntimeDeps_BUILD_TYPE "@PRAENORA_DEPS_BUILD_TYPE@")

# Versions of what the bundle holds.
set(PraenoraRuntimeDeps_LLVM_VERSION "@PRAENORA_DEPS_LLVM_INSTALLED@")
set(PraenoraRuntimeDeps_LLVM_TARGETS "@PRAENORA_DEPS_LLVM_TARGETS_INSTALLED@")
set(PraenoraRuntimeDeps_ROADRUNNER_VERSION "@PRAENORA_DEPS_ROADRUNNER_INSTALLED@")
set(PraenoraRuntimeDeps_ANTIMONY_VERSION "@PRAENORA_DEPS_ANTIMONY_INSTALLED@")
set(PraenoraRuntimeDeps_LIBSBML_VERSION "@PRAENORA_DEPS_LIBSBML_INSTALLED@")
set(PraenoraRuntimeDeps_SUNDIALS_VERSION "@PRAENORA_DEPS_SUNDIALS_INSTALLED@")
set(PraenoraRuntimeDeps_SBMLNETWORK_VERSION "@PRAENORA_DEPS_SBMLNETWORK_INSTALLED@")
set(PraenoraRuntimeDeps_NLOHMANN_JSON_VERSION "@PRAENORA_DEPS_NLOHMANN_JSON_INSTALLED@")
set(PraenoraRuntimeDeps_JSON_SCHEMA_VALIDATOR_VERSION
    "@PRAENORA_DEPS_JSON_SCHEMA_VALIDATOR_INSTALLED@")

# What the Praenora runtime's build needs: the directories for CMAKE_PREFIX_PATH, in this order
# (json-schema-validator's, which holds the nlohmann/json it was compiled against, first), and the
# LLVM installation for LLVM_INSTALL_PREFIX.
set(PraenoraRuntimeDeps_PREFIX_PATH "@PRAENORA_DEPS_CONFIG_PREFIX_PATH@")
set(PraenoraRuntimeDeps_LLVM_INSTALL_PREFIX "${PraenoraRuntimeDeps_ROOT}/llvm")
set(PraenoraRuntimeDeps_ROADRUNNER_PREFIX "${PraenoraRuntimeDeps_ROOT}/roadrunner")
set(PraenoraRuntimeDeps_ANTIMONY_PREFIX "${PraenoraRuntimeDeps_ROOT}/antimony")
set(PraenoraRuntimeDeps_JSON_SCHEMA_VALIDATOR_PREFIX
    "${PraenoraRuntimeDeps_ROOT}/json-schema-validator")

if(NOT EXISTS "${PraenoraRuntimeDeps_MANIFEST}")
    set(PraenoraRuntimeDeps_FOUND FALSE)
    set(PraenoraRuntimeDeps_NOT_FOUND_MESSAGE "The bundle at ${PraenoraRuntimeDeps_ROOT} is \
incomplete: praenora-runtime-deps.json is missing.")
endif()
