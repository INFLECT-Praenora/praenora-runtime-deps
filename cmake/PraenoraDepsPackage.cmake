# The bundle step and the archive.
#
# - The target praenora_deps_bundle (part of the default build) runs cmake/PraenoraDepsBundle.cmake
#   after the upstream builds. It reads the versions the installed files report, stops when one
#   differs from cmake/PraenoraDepsVersions.cmake, copies the license files into licenses/, and
#   writes the manifest praenora-runtime-deps.json and the CMake package PraenoraRuntimeDeps into
#   the bundle (docs/outputs.md).
# - The target package (CPack) builds everything, then archives the bundle as
#   package/<package name>.tar.xz (.zip on Windows) in the build tree, with a top-level directory
#   of the same name and a .sha256 file beside it.

include_guard(GLOBAL)

find_package(Git QUIET)

# The inputs of the bundle script, written when they change.
set(PRAENORA_DEPS_SOURCE_DIR "${PROJECT_SOURCE_DIR}")
set(PRAENORA_DEPS_BUNDLE_DIR "${CMAKE_INSTALL_PREFIX}")
set(PRAENORA_DEPS_VERSION "${PROJECT_VERSION}")
set(PRAENORA_DEPS_HOMEPAGE "${PROJECT_HOMEPAGE_URL}")
set(PRAENORA_DEPS_BUILD_TYPE "${CMAKE_BUILD_TYPE}")
set(PRAENORA_DEPS_GIT "${GIT_EXECUTABLE}")
set(_praenora_deps_inputs "# Generated by cmake/PraenoraDepsPackage.cmake: the inputs of \
cmake/PraenoraDepsBundle.cmake.\n")
foreach(_praenora_deps_variable IN ITEMS
        PRAENORA_DEPS_SOURCE_DIR PRAENORA_DEPS_BUNDLE_DIR PRAENORA_DEPS_WORK_DIR
        PRAENORA_DEPS_VERSION PRAENORA_DEPS_HOMEPAGE PRAENORA_DEPS_MANIFEST_VERSION
        PRAENORA_DEPS_PACKAGE_NAME
        PRAENORA_DEPS_OS PRAENORA_DEPS_ARCH PRAENORA_DEPS_OS_MIN_VERSION
        PRAENORA_DEPS_DISTRIBUTION PRAENORA_DEPS_COMPILER_ID PRAENORA_DEPS_COMPILER_VERSION
        PRAENORA_DEPS_COMPILER_LABEL PRAENORA_DEPS_CXX_STDLIB PRAENORA_DEPS_MSVC_RUNTIME
        PRAENORA_DEPS_CONFIG_LABEL PRAENORA_DEPS_BUILD_TYPE PRAENORA_DEPS_GIT
        PRAENORA_DEPS_COMPONENTS)
    string(APPEND _praenora_deps_inputs
        "set(${_praenora_deps_variable} [==[${${_praenora_deps_variable}}]==])\n")
endforeach()
foreach(_praenora_deps_component IN LISTS PRAENORA_DEPS_COMPONENTS)
    foreach(_praenora_deps_field IN ITEMS REPOSITORY REF VERSION LICENSES)
        set(_praenora_deps_variable
            PRAENORA_DEPS_${_praenora_deps_component}_${_praenora_deps_field})
        string(APPEND _praenora_deps_inputs
            "set(${_praenora_deps_variable} [==[${${_praenora_deps_variable}}]==])\n")
    endforeach()
endforeach()
set(PRAENORA_DEPS_BUNDLE_INPUTS "${PROJECT_BINARY_DIR}/praenora-deps-bundle-inputs.cmake")
file(CONFIGURE OUTPUT "${PRAENORA_DEPS_BUNDLE_INPUTS}" CONTENT "${_praenora_deps_inputs}" @ONLY)

add_custom_target(praenora_deps_bundle ALL
    COMMAND "${CMAKE_COMMAND}" "-DPRAENORA_DEPS_BUNDLE_INPUTS=${PRAENORA_DEPS_BUNDLE_INPUTS}"
            -P "${PROJECT_SOURCE_DIR}/cmake/PraenoraDepsBundle.cmake"
    COMMENT "Checking the bundle and writing its manifest and CMake package"
    VERBATIM)
add_dependencies(praenora_deps_bundle ${PRAENORA_DEPS_COMPONENTS})

# The archive: the bundle directory as it is after the build.
set(CPACK_PACKAGE_NAME "praenora-runtime-deps")
set(CPACK_PACKAGE_VENDOR "INFLECT-Praenora")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_FILE_NAME "${PRAENORA_DEPS_PACKAGE_NAME}")
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_BINARY_DIR}/package")
if(WIN32)
    set(CPACK_GENERATOR ZIP)
else()
    set(CPACK_GENERATOR TXZ)
endif()
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
set(CPACK_INSTALLED_DIRECTORIES "${CMAKE_INSTALL_PREFIX};.")
set(CPACK_INSTALL_CMAKE_PROJECTS "")
set(CPACK_PACKAGE_CHECKSUM SHA256)
set(CPACK_THREADS 0)
set(CPACK_SOURCE_GENERATOR "")
set(CPACK_VERBATIM_VARIABLES ON)
include(CPack)
